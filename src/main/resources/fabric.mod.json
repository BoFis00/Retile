			"com.retile.Retile"
		],
		"client": [
			"com.retile.client.RetileClient"
		]
	},
	"mixins": [
		"retile.mixins.json",
		{
			"config": "retile.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
