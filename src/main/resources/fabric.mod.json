{
	"schemaVersion": 1,
	"id": "retile",
	"version": "${version}",
	"name": "Retile",
	"description": "Creative building brush with weighted random blocks, live outlines and per-player undo/redo.",
	"authors": [
		"Retile"
	],
	"license": "CC0-1.0",
	"icon": "assets/retile/icon.png",
	"environment": "*",
